# ---------- Loja ----------
STORE_NAME=Pet Shop do Bairro
# WhatsApp da loja (com DDD; ex.: 11999998888). Recebe os avisos de ração acabando.
STORE_WHATSAPP=
# Senha do painel da loja (/loja). Obrigatória em produção.
STORE_ADMIN_PASSWORD=

# ---------- Servidor ----------
PORT=3000
NODE_ENV=development
DATABASE_PATH=data/app-pet.db
# A cada quantos minutos o servidor confere os estoques
CHECK_INTERVAL_MINUTES=15

# ---------- Aviso à loja por WhatsApp ----------
# console  -> só registra no log (padrão; bom para testar)
# meta     -> API oficial do WhatsApp Cloud (Meta)
# webhook  -> envia um POST JSON para Z-API, Evolution API, n8n, Make etc.
WHATSAPP_PROVIDER=console

# provider=meta
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
# Mensagens iniciadas pela empresa exigem um template aprovado pela Meta.
# Corpo do template com 4 variáveis: {{1}} cliente, {{2}} pet, {{3}} dias restantes, {{4}} WhatsApp do cliente
WHATSAPP_META_TEMPLATE=
WHATSAPP_META_TEMPLATE_LANG=pt_BR

# provider=webhook
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# ---------- E-mail para o tutor (opcional) ----------
SMTP_URL=
# ex.: smtps://usuario:senha@smtp.exemplo.com:465
MAIL_FROM=

# ---------- Notificação push (opcional) ----------
# Se vazio, as chaves VAPID são geradas e guardadas no banco na primeira execução.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@suaLoja.com.br
