# ---------- Servidor ----------
PORT=3000
NODE_ENV=development
# Endereço público (usado nos links de convite e e-mails). Em produção, com https.
PUBLIC_URL=http://localhost:3000
# Segredo para assinar links temporários de documentos. Obrigatório em produção (32+ caracteres).
APP_SECRET=
DATABASE_PATH=data/vagari.db
# Arquivos privados (vouchers, bilhetes, fotos). Nunca aponte para uma pasta pública.
STORAGE_DIR=data/files
TMP_DIR=data/tmp
MAX_UPLOAD_MB=25

# ---------- Equipe ----------
# E-mails que viram administradores no primeiro acesso (separados por vírgula).
ADMIN_EMAILS=

# ---------- E-mail (códigos de acesso, convites, avisos) ----------
# Sem SMTP, em desenvolvimento os e-mails aparecem no log do servidor.
SMTP_URL=
# ex.: smtps://usuario:senha@smtp.exemplo.com:465
MAIL_FROM=Vagari <nao-responda@vagari.com.br>

# ---------- Demonstração ----------
# 1 = ambiente de demonstração com dados fictícios. Use outro DATABASE_PATH (ex.: data/demo.db).
DEMO_MODE=0

# WhatsApp, horário de atendimento, categorias e prazos ficam no painel (Configurações), não aqui.
